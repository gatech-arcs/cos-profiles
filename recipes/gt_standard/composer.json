{
    "name": "gtsciences/gt_standard",
    "description": "Drupal recipe for starting a Drupal project",
    "type": "drupal-recipe",
    "keywords": ["Drupal recipe", "recipe", "Site"],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Michael Sheldon",
            "homepage": "https://cos.gatech.edu/",
            "role": "Maintainer"
