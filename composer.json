{
    "name": "gtsciences/gt_kickoff",
    "description": "GT College of Sciences Drupal installation kickoff, for a more civilized age. Now with recipes",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://cos.gatech.edu/",
    "lifecycle": "stable",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "_comment": [
        "This is how you put comments into a composer.json file https://getcomposer.org/doc/04-schema.md#-comment",
        "composer/installers reference https://github.com/composer/installers",

        "Need to inject/update services.yml with security.enable_super_user: false - https://www.drupal.org/node/2910500",

        "DEV - DCG reference https://github.com/Chi-teck/drupal-code-generator",

        "Pending Views Contextual Filter Title fix https://www.drupal.org/project/drupal/issues/2787051",

        "Math? https://www.drupal.org/project/symfony_mailer or https://www.drupal.org/project/symfony_mailer_lite",
        "Profiles? Generic vs Research vs Admin sets https://www.drupal.org/project/profile",
        "webforms? https://www.drupal.org/project/antibot",

        "Microcontent? vs all custom blocks: https://www.drupal.org/project/microcontent",
        "INVESTIGATE: Maybe https://www.drupal.org/project/workbench_access instead of group?",
        "GROUP is having a lot of issues still https://www.drupal.org/project/group",

        "INVESTIGATE:    drupal/field_permissions for easier restrictions",
        "INVESTIGATE:    drupal/tvi for taxonomy display control",

        "redirect_after_login may be useful once D11 compat",
        "possible config help drupal/update_helper and drupal/config_modify",
        "temp removal of gtsciences/gt_social for testing",
        "no d11 - drupal/content_export_csv: ^4.8",
        "scheduling option? https://www.drupal.org/project/scheduled_transitions"
    ],

    "minimum-stability": "dev",
    "prefer-stable": true,

    "require": {
        "php": "^8.3",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/address": "^2.0",
        "drupal/bpmn_io": "^3.0",
        "drupal/cas": "^3.0@beta",
        "drupal/cas_attributes": "^3.0@beta",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/core": "^11.2",
        "drupal/core-composer-scaffold": "^11.2",
        "drupal/core-recipe-unpack": "^11.2",
        "drupal/eca": "^3.0",
        "drupal/entity_reference_revisions": "^1.10",
        "drupal/externalauth": "^2.0",
        "drupal/geocoder": "^4.28",
        "drupal/geofield": "^1.64",
        "drupal/geofield_map": "^11.0",
        "drupal/inline_entity_form": "^3.0",
        "drupal/paragraphs": "^1.17",
        "drupal/pathauto": "^1.13",
        "drupal/twig_tweak": "^3.4",
        "drush/drush": "^13.6",
        "gtsciences/gt_admin": "*",
        "gtsciences/gt_editorial": "*",
        "gtsciences/gt_seo": "*",
        "gtsciences/gt_standard": "*",
        "gtsciences/gt_theme": "^1.0",
        "gtsciences/gt_tools": "^1.0",
        "gtsciences/hg_reader": "^5.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "platformsh/config-reader": "^3.0",
        "webflo/drupal-finder": "^1.3",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "drupal/core-dev": "^11.2",
        "drupal/coder": "^8.3",
        "drupal/devel": "^5.4",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_source_csv": "^3.7",
        "drupal/upgrade_status": "^4.3",
        "drupal/views_data_export": "^1.6",
        "drupal/webprofiler": "^11.1",
        "chi-teck/drupal-code-generator": "^4.2",
        "kevinquillen/recipe-generator": "^2.0",
        "mglaman/phpstan-drupal": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "config": {
        "allow-plugins": {
            "chi-teck/drupal-code-generator": true,
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "deployer/deployer": true,
            "drupal/*": true,
            "drush/*": true,
            "gtsciences/*": true,
            "kevinquillen/*": true,
            "mglaman/phpstan-drupal": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/*": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true,
            "drupal/core-recipe-unpack": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "recipes/{$name}": ["type:drupal-recipe"]
        },
        "merge-plugin": {
            "include": [ "web/modules/contrib/*/composer.libraries.json" ]
        },
        "file-mapping": {
            "web/android-chrome-192x192.png": {
                "path": "assets/android-chrome-192x192.png",
                "overwrite": true
            },
            "web/android-chrome-512x512.png": {
                "path": "assets/android-chrome-512x512.png",
                "overwrite": true
            },
            "web/apple-touch-icon.png": {
                "path": "assets/apple-touch-icon.png",
                "overwrite": true
            },
            "web/browserconfig.xml": {
                "path": "assets/browserconfig.xml",
                "overwrite": true
            },
            "web/favicon.ico": {
                "path": "assets/favicon.ico",
                "overwrite": true
            },
            "web/favicon-16x16.png": {
                "path": "assets/favicon-16x16.png",
                "overwrite": true
            },
            "web/favicon-32x32.png": {
                "path": "assets/favicon-32x32.png",
                "overwrite": true
            },
            "web/mstile-150x150.png": {
                "path": "assets/mstile-150x150.png",
                "overwrite": true
            },
            "web/mstile-310x310.png": {
                "path": "assets/mstile-310x310.png",
                "overwrite": true
            },
            "web/safari-pinned-tab.svg": {
                "path": "assets/safari-pinned-tab.svg",
                "overwrite": true
            },
            "web/site.webmanifest": {
                "path": "assets/site.webmanifest",
                "overwrite": true
            }
        },
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
        },
        "_patches_check_later": {
            "drupal/core": {
            },
            "drupal/entity_browser": {
                "2897855 - https://www.drupal.org/node/2897855 - Entity browser modal dialog opens by pressing enter in any text field": "https://www.drupal.org/files/issues/2020-10-07/prevent-entity-browser-from-open-on-enter-key-pressed-2897855-17-reroll-with-improvement.patch"
            }
        }
    }
}
