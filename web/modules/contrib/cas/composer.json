      "role": "Maintainer"
    },
    {
      "name": "See other contributors",
      "homepage": "https://www.drupal.org/node/78967/committers",
      "role": "contributor"
    }
  ],
  "support": {
    "issues": "http://drupal.org/project/issues/cas",
    "irc": "irc://irc.freenode.org/drupal-contribute",
    "source": "https://git.drupalcode.org/project/cas"
  },
  "license": "GPL-2.0-or-later",
  "minimum-stability": "dev",
  "require": {
    "ext-dom": "*",
    "drupal/externalauth": "~2.0.6",
    "drupal/js_cookie": "^1.0"
  },
  "require-dev": {
    "drupal/cas_mock_server": "^2.0",
    "drupal/http_request_mock": "^1.1",
    "drush/drush": "^12 || ^13"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "tbachert/spi": true
    }
