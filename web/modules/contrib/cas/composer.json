{
  "name": "drupal/cas",
  "description": "Provides CAS authentication for Drupal.",
  "type": "drupal-module",
  "homepage": "http://drupal.org/project/cas",
  "authors": [
    {
      "name": "David Metzler",
      "homepage": "https://www.drupal.org/u/metzlerd",
      "role": "Maintainer"
    },
    {
      "name": "Brian Osborne",
      "homepage": "https://www.drupal.org/u/bkosborne",
      "role": "Maintainer"
    },
    {
      "name": "Tim Yale",
